# Cloudflare Configuration & API Credentials
CLOUDFLARE_ACCOUNT_ID="fa73541af4fcdd947ab78c12fe990a34"
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID="fa73541af4fcdd947ab78c12fe990a34"
CF_TOKEN=

# Cloudflare Worker URL (تمت الإضافة لربط التطبيق بالوركر والـ R2/KV بأمان تام)
VITE_WORKER_URL="https://rooh-platform-worker.your-subdomain.workers.dev"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# Groq / Proq API Key (Flagship LLaMA models for Developer Agent)
GROQ_API_KEY=

# ElevenLabs Voice AI API Key (Voice Synthesis for Developer Agent)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# OneSignal Credentials (used securely server-side for push notifications)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Developer Credentials (Optional - if DB is empty, first login registers as admin/developer with their PIN)
ADMIN_EMAIL=
ADMIN_PIN=

# GitHub Actions Webhook Integration (Optional for triggering auto-build & deploy on app approval)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Google Indexing API & OAuth Credentials (Instant indexing notification)
GOOGLE_INDEXING_API_KEY=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Custom Search API Credentials
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=a1d67cd9cbb674db2